RewriteEngine On
RewriteBase /

# 1. Proxy WebSocket connections for Socket.io
RewriteCond %{HTTP:Upgrade} websocket [NC]
RewriteCond %{HTTP:Connection} upgrade [NC]
RewriteRule ^packs/api/socket\.io/(.*)$ ws://127.0.0.1:9082/packs/api/socket.io/$1 [P,L]

RewriteCond %{HTTP:Upgrade} websocket [NC]
RewriteCond %{HTTP:Connection} upgrade [NC]
RewriteRule ^socket\.io/(.*)$ ws://127.0.0.1:9082/packs/api/socket.io/$1 [P,L]

# 2. Proxy HTTP API and Socket.io polling requests to Node backend (port 9082)
RewriteRule ^packs/api/(.*)$ http://127.0.0.1:9082/packs/api/$1 [P,L]
RewriteRule ^api/(.*)$ http://127.0.0.1:9082/packs/api/$1 [P,L]
RewriteRule ^socket\.io/(.*)$ http://127.0.0.1:9082/packs/api/socket.io/$1 [P,L]

# 3. Frontend SPA Fallback
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

